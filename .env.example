# Backend REST API base URL (required in production; the build fails without it).
# In development it defaults to http://localhost:5000/api/v1 when unset.
NEXT_PUBLIC_API_URL=https://api.curevie.net/api/v1

# Public URL of this patient site (canonical URLs, sitemap, robots).
# NEXT_PUBLIC_SITE_URL wins over NEXT_PUBLIC_APP_URL when both are set.
NEXT_PUBLIC_SITE_URL=https://www.curevie.net
NEXT_PUBLIC_APP_URL=https://www.curevie.net

# Online ordering. Enabled when unset; set to "false" to show the pre-launch notice instead.
NEXT_PUBLIC_BOOKINGS_ENABLED=true

# Analytics (optional). GA loads only when this is set and the visitor accepts analytics cookies; the Meta Pixel is off when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
